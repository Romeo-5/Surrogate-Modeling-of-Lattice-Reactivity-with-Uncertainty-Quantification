# Campaign output. The per-run JSON files are the resumable working state and
# are regenerated by scripts/run_campaign.py (the design is seeded, so the same
# points come back). The Parquet roll-up and the campaign summary are NOT
# ignored: they are a few tens of KB and they let someone rerun the whole
# surrogate analysis without spending an hour and a half on transport.
/data/runs/
/data/spectra/
/data/failures.log

# Cross-section libraries live in a mounted volume, never in the repo.
/cross_sections/
*.tar.xz

# OpenMC scratch
statepoint.*.h5
summary.h5
tallies.out
*.ppm
geometry.xml
materials.xml
settings.xml
tallies.xml
plots.xml
model.xml

# results/ is deliberately NOT ignored: the figures and JSON reports are the
# deliverable, and a reader should see them without running a campaign.

__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
